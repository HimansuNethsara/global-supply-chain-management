{
  "name": "globaltrade-logistics",
  "version": "1.0.0",
  "description": "Global Supply Chain Management System",
  "scripts": {
    "clean": "rimraf ./src/main/webapp/css/output.css",
    "build": "npm run clean && tailwindcss -i ./src/main/webapp/css/app.css -o ./src/main/webapp/css/output.css --minify",
    "watch": "npm run clean && tailwindcss -i ./src/main/webapp/css/app.css -o ./src/main/webapp/css/output.css --watch"
  },
  "devDependencies": {
    "daisyui": "^4.12.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.0"
  },
  "private": true
}